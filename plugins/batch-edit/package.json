  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "picomatch": "4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
